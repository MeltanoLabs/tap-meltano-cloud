# MeltanoCloud Configuration
# Copy this file to .env and fill in your actual values

# Authentication — provide ONE of the following two options:

# Option 1: static bearer token
# TAP_MELTANO_CLOUD_AUTH_TOKEN=your_auth_token_here

# Option 2: OAuth2 client credentials (token is fetched and refreshed automatically)
# TAP_MELTANO_CLOUD_CLIENT_ID=your_client_id_here
# TAP_MELTANO_CLOUD_CLIENT_SECRET=your_client_secret_here
# TAP_MELTANO_CLOUD_OAUTH_TOKEN_URL=https://matatika.eu.auth0.com/oauth/token
# Optional — defaults to TAP_MELTANO_CLOUD_API_URL when not set
# TAP_MELTANO_CLOUD_OAUTH_AUDIENCE=https://app.matatika.com/api

# Optional: API URL (defaults to https://app.matatika.com/api)
TAP_MELTANO_CLOUD_API_URL=https://app.matatika.com/api

# Optional: Comma-separated list of workspace IDs to sync (JSON array format)
# When set, only those workspaces are fetched; omit to sync all accessible workspaces
# TAP_MELTANO_CLOUD_WORKSPACE_IDS=["workspace-uuid-1","workspace-uuid-2"]
